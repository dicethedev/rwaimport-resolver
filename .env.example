# Environment files are not loaded automatically. Use shell exports or a process manager.
RESOLVER_BIND=127.0.0.1:3001
# REGISTRY_DIST_DIR=/absolute/path/to/rwaimport-registry/dist
# RPC_URLS takes precedence over RPC_URLS_FILE. Never commit private provider keys.
RPC_URLS_FILE=./config/public-rpc.json
# RPC_URLS={"1":"https://your-provider.example/your-key"}
RPC_TIMEOUT_MS=2000
RPC_RETRIES=1
RESOLVE_TIMEOUT_MS=8000
REGISTRY_REFRESH_INTERVAL_MS=60000
RESOLVER_CACHE_TTL_MS=15000
RESOLVER_CACHE_MAX_ENTRIES=256
RESOLVER_CACHE_MAX_BYTES=8388608
RESOLVER_MAX_CONCURRENCY=16

# Optional ordered failover providers; configured once at startup.
# RPC_BACKUP_URLS={"1":["https://another-provider.example"]}
# LEDGER_URLS={"solana":["https://api.mainnet-beta.solana.com"],"stellar":["https://horizon.stellar.org"],"aptos":["https://api.mainnet.aptoslabs.com/v1/"]}
